<html>
<head></head>
<body>
<form method="get" action="{{ path: app_search_book }}">
    <input type="text" name="name">
    <input type="submit" value="Search">
</form>
<h1>Table of books</h1>
<table>
    <tr><th>id</th><th>title</th><th>author name</th></tr>
    <tr {% for book in books %}>
        <td>{{ book.id }}</td>
        <td>{{ book.title }}</td>
        <td>{{ book.author.name}}</td>
    </tr{% endfor %}>
</table>
</body>
</html>
